# Database Connection
# Leave as sqlite:///./music_stats.db for local development,
# or use postgresql+psycopg://user:password@host/dbname?sslmode=require for Neon/Production
DATABASE_URL=sqlite:///./music_stats.db

# Admin Key for Protected Routes (Syncing Data, Adding/Deleting Shelf Media)
# Leave empty locally for unlocked dev mode, or set a strong secret string in production
ADMIN_SECRET=

# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173

# Optional: Spotify API Auto-Sync Credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=